# Configuracion del frontend. Copia este fichero a `.env.local` y rellenalo.

# URL de la API. En desarrollo, la que levanta docker compose.
VITE_API_URL=http://localhost:8000

# Configuracion web de Firebase Authentication.
# Project settings > Your apps > Web app > "SDK setup and configuration" > Config.
# Son valores publicos por diseño (identifican el proyecto, no dan acceso).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=