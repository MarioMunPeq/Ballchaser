ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql+psycopg://ballchaser:ballchaser@localhost:5432/ballchaser
CORS_ORIGINS=["http://localhost:5173"]
# Fase 2: token personal de Ballchasing, solo para desarrollo. En produccion lo
# guarda cada usuario, cifrado, en la base de datos.
#BALLCASING_API_KEY=
# Clave de servicio de Firebase (Project settings > Service accounts).
# Ruta al JSON descargado (recomendado) o el JSON entero en una sola linea.
FIREBASE_CREDENTIALS_FILE=secrets/firebase-service-account.json
#FIREBASE_CREDENTIALS_JSON=
#SECRET_ENCRYPTION_KEY=
#SECRET_KEY_VERSION=1
#CRON_SECRET=
#METRICS_TOKEN=